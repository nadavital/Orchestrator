{
  "name": "orchestrator",
  "version": "1.0.0",
  "description": "Orchestrate multiple AI coding agent sessions simultaneously",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.navital.orchestrator",
    "productName": "Orchestrator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/OrchestratorIcon.icns",
      "identity": null,
      "target": [
        "dir",
        "dmg",
        "zip"
      ]
    },
    "extraResources": [
      {
        "from": "resources/pets",
        "to": "pets",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:mac": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "test:providers": "tsc -p tsconfig.node.json --outDir out-test --module commonjs && node --test out-test/src/main/__tests__/*.test.js",
    "test:smoke-config": "node --test scripts/provider-smoke-config.test.mjs",
    "smoke:providers": "tsc -p tsconfig.node.json --outDir out-test --module commonjs && node scripts/provider-diagnostics.mjs",
    "live:providers": "tsc -p tsconfig.node.json --outDir out-test --module commonjs && node scripts/provider-live-smoke.mjs",
    "live:claude-runtimes": "tsc -p tsconfig.node.json --outDir out-test --module commonjs && node scripts/claude-runtime-parity.mjs",
    "live:claude-capabilities": "tsc -p tsconfig.node.json --outDir out-test --module commonjs && node scripts/claude-live-capability-suite.mjs",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "echo 'Run npm run rebuild to build native modules'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/asar": "^3.4.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^8.2.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.27.0",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "fast-uri": "^3.0.1",
    "rollup": "^4.27.4",
    "tailwindcss": "^4.0.0",
    "tapable": "^2.2.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
